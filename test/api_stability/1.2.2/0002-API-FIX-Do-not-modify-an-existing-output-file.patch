From 0b1c3072aa93865f3fc6f3ee6d8370ad37a0bbfd Mon Sep 17 00:00:00 2001
From: Enrico Seiler <enrico.seiler@hotmail.de>
Date: Fri, 30 Oct 2026 16:07:41 +0100
Subject: [PATCH 2/2] [API] [FIX] Do not modify an existing output file

The output_file_validator with output_file_open_options::open_or_create no longer empties and
deletes an existing file. The test now asserts that the file and its content are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../parser/format_parse_validators_test.cpp   | 65 ++++++++++++++++++-
 1 file changed, 63 insertions(+), 2 deletions(-)

diff --git a/test/unit/parser/format_parse_validators_test.cpp b/test/unit/parser/format_parse_validators_test.cpp
index 0fd2c45..2a8cafd 100644
--- a/test/unit/parser/format_parse_validators_test.cpp
+++ b/test/unit/parser/format_parse_validators_test.cpp
@@ -4,6 +4,8 @@
 
 #include <gtest/gtest.h>
 
+#include <fstream>
+#include <iterator>
 #include <ranges>
 
 #include <sharg/parser.hpp>
@@ -11,6 +13,12 @@
 #include <sharg/test/test_fixture.hpp>
 #include <sharg/test/tmp_filename.hpp>
 
+static std::string file_content(std::filesystem::path const & path)
+{
+    std::ifstream file{path};
+    return {std::istreambuf_iterator<char>{file}, std::istreambuf_iterator<char>{}};
+}
+
 class validator_test : public sharg::test::test_fixture
 {};
 
@@ -138,6 +146,7 @@ TEST_F(validator_test, output_file)
 
     { // Open fstream to create files.
         std::ofstream tmp_file{existing_path};
+        tmp_file << "existing content";
     }
 
     using options = sharg::output_file_open_options;
@@ -174,9 +183,10 @@ TEST_F(validator_test, output_file)
 
     // file does exist but allow to overwrite it
     my_validator = sharg::output_file_validator{options::open_or_create, formats};
-    EXPECT_TRUE(std::filesystem::exists(existing_path)); // Todo: Expected?
     EXPECT_NO_THROW(my_validator(existing_path));
-    EXPECT_FALSE(std::filesystem::exists(existing_path)); // Todo: Expected?
+    // The application may still fail after validation, so the validator must not modify the file.
+    EXPECT_TRUE(std::filesystem::exists(existing_path));
+    EXPECT_EQ(file_content(existing_path), "existing content");
 
     // file has no extension.
     std::filesystem::path test_path = not_existing_path;
@@ -472,6 +482,39 @@ TEST_F(validator_test, outputfile_not_writable)
                                  std::filesystem::perm_options::add);
 }
 
+TEST_F(validator_test, outputfile_existing_not_writable)
+{
+    sharg::test::tmp_filename const tmp_name{"my_file.test"};
+    std::filesystem::path const & tmp_file{tmp_name.get_path()};
+
+    { // Open fstream to create files.
+        std::ofstream file{tmp_file};
+        file << "existing content";
+    }
+
+    sharg::output_file_validator my_validator{sharg::output_file_open_options::open_or_create};
+
+    EXPECT_NO_THROW(my_validator(tmp_file));
+    EXPECT_EQ(file_content(tmp_file), "existing content");
+
+    // The file is not writable, but the parent path is.
+    std::filesystem::permissions(tmp_file,
+                                 std::filesystem::perms::owner_write | std::filesystem::perms::group_write
+                                     | std::filesystem::perms::others_write,
+                                 std::filesystem::perm_options::remove);
+
+    if (!sharg::test::write_access(tmp_file)) // Do not execute with root permissions.
+    {
+        EXPECT_THROW(my_validator(tmp_file), sharg::validation_error);
+        EXPECT_EQ(file_content(tmp_file), "existing content");
+    }
+
+    std::filesystem::permissions(tmp_file,
+                                 std::filesystem::perms::owner_write | std::filesystem::perms::group_write
+                                     | std::filesystem::perms::others_write,
+                                 std::filesystem::perm_options::add);
+}
+
 TEST_F(validator_test, output_parent_dir_not_writable)
 {
     sharg::test::tmp_filename const tmp_name{"dir"};
@@ -541,6 +584,24 @@ TEST_F(validator_test, outputdir_not_writable)
                                  std::filesystem::perm_options::add);
 }
 
+// The output_directory_validator checks the permissions by writing dummy.txt into the directory.
+TEST_F(validator_test, outputdir_existing_dummy_file)
+{
+    sharg::test::tmp_filename const tmp_name{"dir"};
+    std::filesystem::path const & tmp_dir{tmp_name.get_path()};
+    std::filesystem::path const dummy_file{tmp_dir / "dummy.txt"};
+
+    std::filesystem::create_directory(tmp_dir);
+    { // Open fstream to create files.
+        std::ofstream file{dummy_file};
+        file << "existing content";
+    }
+
+    EXPECT_NO_THROW(sharg::output_directory_validator{}(tmp_dir));
+    EXPECT_TRUE(std::filesystem::exists(dummy_file));
+    EXPECT_EQ(file_content(dummy_file), "existing content");
+}
+
 TEST_F(validator_test, arithmetic_range_validator_success)
 {
     int value{};
